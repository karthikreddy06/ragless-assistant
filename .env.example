# ==============================================================================
# RAGless Assistant - Environment Configuration Template
# ==============================================================================

# Environment: "development" (default local) or "production" (enforces strict secret checks)
ENVIRONMENT=development

# LLM Provider Selection: "ollama" (default local) or "nebius" (cloud Token Factory)
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# Nebius Token Factory / NVIDIA Nemotron Configuration
# (Required when LLM_PROVIDER=nebius)
# ------------------------------------------------------------------------------
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ------------------------------------------------------------------------------
# General LLM Parameters
# ------------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# Local Ollama Configuration (retained for backward compatibility)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30

# ------------------------------------------------------------------------------
# Tavily Web Research Configuration (Phase 4)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_TIMEOUT_SECONDS=10
WEB_MAX_CALLS_PER_REQUEST=2

# ------------------------------------------------------------------------------
# Knowledge Import Protection
# ------------------------------------------------------------------------------
# Required in production mode (min 16 random characters).
# If set, POST /knowledge/import requires matching header 'X-Admin-Token'.
# If unset in development mode, endpoint is accessible without header.
ADMIN_TOKEN=your_admin_token_here

# ------------------------------------------------------------------------------
# Latency & Optimization Flags
# ------------------------------------------------------------------------------
FAST_PATH_ENABLED=true
DETERMINISTIC_ANSWERS_ENABLED=true
WARMUP_ON_STARTUP=false
PLANNER_MAX_TOKENS=512
SYNTHESIS_MAX_TOKENS=512

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DATABASE_PATH=knowledge.db

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# Set to true to enforce the Secure flag on HttpOnly session cookies (required for HTTPS/production)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Production CORS & Proxy Headers Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. "https://my-app.onrender.com").
# In production, leaving this empty defaults strictly to same-origin only.
ALLOWED_ORIGINS=

# Set to true when running behind a trusted reverse proxy (e.g. Render, Cloudflare)
# to safely parse client IP addresses from proxy-appended headers without IP spoofing.
TRUST_PROXY_HEADERS=true

# ------------------------------------------------------------------------------
# In-Memory Rate Limiting Configuration
# ------------------------------------------------------------------------------
# Login failure lockout: max failures within window seconds
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300

# Registration rate limit: max registrations per IP within window seconds
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=300

# Agent queries rate limit: max queries per user/IP within window seconds
RATE_LIMIT_AGENT_MAX=20
RATE_LIMIT_AGENT_WINDOW=60
